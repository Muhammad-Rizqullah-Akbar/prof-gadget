// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Tabel User (Admin & Teknisi)
model User {
  id        Int       @id @default(autoincrement())
  name      String
  username  String    @unique
  password  String
  role      Role      @default(TECHNICIAN)
  services  Service[] // Relasi: User ini ngerjain servis apa aja
  createdAt DateTime  @default(now())
}

// 2. Tabel Customer
model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  address   String?
  services  Service[] // Relasi: Customer ini pernah servis apa aja
  createdAt DateTime  @default(now())
}

// 3. Tabel Utama Servis (Tiket)
model Service {
  id            Int            @id @default(autoincrement())
  ticketNumber  String         @unique // Contoh: SRV-001
  deviceType    String         // HP, Laptop, dll
  deviceModel   String         // Samsung A50, Macbook Air
  complaint     String         // Keluhan
  diagnosis     String?        // Hasil cek teknisi
  status        ServiceStatus  @default(PENDING)
  
  // Relasi
  customerId    Int
  customer      Customer       @relation(fields: [customerId], references: [id])
  technicianId  Int
  technician    User           @relation(fields: [technicianId], references: [id])
  
  items         ServiceItem[]  // Relasi ke detail biaya
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 4. Tabel Detail Biaya & Belanja (Keuangan)
model ServiceItem {
  id           Int      @id @default(autoincrement())
  serviceId    Int
  service      Service  @relation(fields: [serviceId], references: [id])
  
  itemName     String   // Nama barang / Jasa
  category     ItemCategory // PART atau SERVICE
  
  buyPrice     Decimal  @default(0) // Modal (Teknisi input ini)
  sellPrice    Decimal  @default(0) // Harga Jual ke Customer
  
  receiptImage String?  // URL Foto Nota Belanja
  
  createdAt    DateTime @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  name        String   // Misal: "Listrik Juli", "Gaji Teknisi A"
  amount      Decimal  // Nominal
  date        DateTime @default(now()) // Tanggal pengeluaran
  createdAt   DateTime @default(now())
}

// --- Tipe Data Enum (Pilihan Tetap) ---

enum Role {
  ADMIN
  TECHNICIAN
}

enum ServiceStatus {
  PENDING       // Baru masuk
  DIAGNOSING    // Sedang dicek
  CONFIRMATION  // Nunggu user setuju harga
  WORKING       // Sedang dikerjakan/belanja
  DONE          // Selesai dikerjakan (Belum bayar)
  COMPLETED     // Lunas & Diambil
  CANCELLED     // Batal
}

enum ItemCategory {
  PART    // Suku Cadang
  SERVICE // Jasa
}