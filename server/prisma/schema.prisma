generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  username  String    @unique
  password  String
  role      Role      @default(TECHNICIAN)
  createdAt DateTime  @default(now())
  services  Service[]
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  address   String?
  createdAt DateTime  @default(now())
  services  Service[]
}

model Service {
  id           Int           @id @default(autoincrement())
  ticketNumber String        @unique
  deviceType   String
  deviceModel  String
  complaint    String
  diagnosis    String?
  status       ServiceStatus @default(PENDING)
  customerId   Int
  technicianId Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customer     Customer      @relation(fields: [customerId], references: [id])
  technician   User          @relation(fields: [technicianId], references: [id])
  items        ServiceItem[]
}

model ServiceItem {
  id           Int          @id @default(autoincrement())
  serviceId    Int
  itemName     String
  category     ItemCategory
  buyPrice     Decimal      @default(0)
  sellPrice    Decimal      @default(0)
  receiptImage String?
  createdAt    DateTime     @default(now())
  service      Service      @relation(fields: [serviceId], references: [id])
}

model Expense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Decimal
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum ServiceStatus {
  PENDING
  DIAGNOSING
  CONFIRMATION
  WORKING
  DONE
  COMPLETED
  CANCELLED
}

enum ItemCategory {
  PART
  SERVICE
}
